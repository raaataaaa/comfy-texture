{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default"},
    "_meta": {"title": "Load Diffusion Model"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default"},
    "_meta": {"title": "Load CLIP"}
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "flux2-vae.safetensors"},
    "_meta": {"title": "Load VAE"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "a red ceramic teapot on a rustic wooden table beside a sunlit window, soft morning light, photorealistic, highly detailed", "clip": ["2", 0]},
    "_meta": {"title": "Positive Prompt"}
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {"conditioning": ["4", 0]},
    "_meta": {"title": "Negative (Zero Out)"}
  },
  "6": {
    "class_type": "CFGGuider",
    "inputs": {"model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0], "cfg": 1},
    "_meta": {"title": "CFGGuider"}
  },
  "7": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "euler"},
    "_meta": {"title": "KSamplerSelect"}
  },
  "8": {
    "class_type": "PrimitiveInt",
    "inputs": {"value": 1024},
    "_meta": {"title": "Width"}
  },
  "9": {
    "class_type": "PrimitiveInt",
    "inputs": {"value": 1024},
    "_meta": {"title": "Height"}
  },
  "10": {
    "class_type": "Flux2Scheduler",
    "inputs": {"steps": 4, "width": ["8", 0], "height": ["9", 0]},
    "_meta": {"title": "Flux2Scheduler"}
  },
  "11": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 42},
    "_meta": {"title": "RandomNoise"}
  },
  "12": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {"width": ["8", 0], "height": ["9", 0], "batch_size": 1},
    "_meta": {"title": "Empty Latent"}
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {"noise": ["11", 0], "guider": ["6", 0], "sampler": ["7", 0], "sigmas": ["10", 0], "latent_image": ["12", 0]},
    "_meta": {"title": "SamplerCustomAdvanced"}
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["13", 0], "vae": ["3", 0]},
    "_meta": {"title": "VAE Decode"}
  },
  "15": {
    "class_type": "SaveImage",
    "inputs": {"images": ["14", 0], "filename_prefix": "Flux2-Klein"},
    "_meta": {"title": "image"}
  }
}
